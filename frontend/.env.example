# Firebase Configuration
# Get these from your Firebase Console: https://console.firebase.google.com
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# OpenAI API Key (for Whisper speech-to-text)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Lingo.dev API Key (for translation)
# Get from: https://lingo.dev/app
# Free tier includes 10,000 words/month
LINGODOTDEV_API_KEY=your_lingo_api_key

# Voice Mode Configuration
# "dev" - Play processed voice locally for testing (you hear your own translated voice)
# "prod" - Send processed voice to remote peer via WebRTC (they hear your translated voice)
NEXT_PUBLIC_VOICE_MODE=dev

# ============================================
# API Gateway / Load Balancer Configuration
# ============================================
# Environment: "dev" or "prod"
# - dev: Uses localhost endpoints directly
# - prod: Uses load balancer (local or remote via Cloudflare)
NEXT_PUBLIC_API_ENV=dev

# Load Balancer URL
# dev: http://localhost:8089 (local load balancer)
# prod: https://meetapi.snipermonkey.in (via Cloudflare tunnel)
NEXT_PUBLIC_LOADBALANCER_URL=http://localhost:8089

# WebSocket protocol (ws for local, wss for remote with SSL)
NEXT_PUBLIC_WS_PROTOCOL=ws
